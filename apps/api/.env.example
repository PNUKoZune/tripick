# App
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://tripick:tripick@localhost:5432/tripick

# Redis
# 로컬은 REDIS_HOST/REDIS_PORT 를 쓴다. 프로덕션(Railway 등 매니지드 Redis)은
# 비밀번호·TLS 가 포함된 REDIS_URL 을 넣으면 host/port 대신 그것을 우선 사용한다.
# 예: REDIS_URL=rediss://default:password@host:6379
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# 아래 예시 값은 레포에 공개돼 있어 NODE_ENV=production 이면 부팅이 거부된다.
# 배포 전에 반드시 임의의 키로 교체할 것 (예: openssl rand -base64 48)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Kakao OAuth, 자동차 경로·ETA: 카카오 모빌리티 길찾기
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/api/v1/auth/kakao/callback
WEB_APP_URL=http://localhost:3000

# CORS 허용 오리진 (쉼표 구분). HTTP·WebSocket 공용.
# 미설정 시 localhost:3000/3001 기본값. 프로덕션은 Vercel 배포 도메인을 지정.
# 예: CORS_ORIGIN=https://tripick.vercel.app
# CORS_ORIGIN=

# Kakao Local API (장소 검색)
KAKAO_LOCAL_API_KEY=
# 런타임 키워드 검색 반경(m). currentLocation 이 있을 때만 적용. 최대 20000
KAKAO_SEARCH_RADIUS_M=20000
# 적재 카테고리 검색 반경(m). 앵커 1곳이 커버하는 범위. 최대 20000
KAKAO_INGEST_RADIUS_M=10000
# 적재 시 시도별 카카오 앵커(장소 좌표 클러스터 중심) 최대 개수.
# 앵커 1곳이 덮는 면적은 반경 10km 원(≈314km²)이라 8곳으로는 시도 하나를 못 덮는다(경기 10,200km²).
# 앵커가 같은 실행의 KTO 좌표에만 묶여 있던 동안엔 8 이상이 무의미했지만, 남은 슬롯을 카탈로그
# 좌표로 채우게 된 뒤로는 서로 다른 관광 밀집지를 짚는다. 비용은 시도당 ≤288 콜(앵커×4카테고리×≤3페이지).
KAKAO_INGEST_MAX_ANCHORS=24

# 네이버 검색 API (NCP API Hub — 블로그·카페 추천 글로 대중 인지도 보정)
# 비워두면 인지도 항이 중립값이 되어 후보 랭킹이 바뀌지 않는다(그레이스풀 비활성).
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 검색어당 블로그·카페 각각 가져올 문서 수 (1~100)
NAVER_SEARCH_DISPLAY=100
# 목적지별 코퍼스 캐시 TTL(시간). 추천 글은 빠르게 바뀌지 않음
NAVER_SEARCH_CACHE_TTL_HOURS=6
# 지역 특이도 하한 — 지역 코퍼스 언급률이 전국 대조 코퍼스의 몇 배 이상이어야 인지도 가점을 줄지.
# 이름이 흔한 한국어 단어인 상호('맛있게')가 남의 언급을 가져가는 것을 막는다(실측 근거: 실제
# 장소 최저 6.0 vs 일반어 최고 4.0). 낮추면 일반어가 섞이고, 높이면 전국적 명소가 중립으로 밀린다.
NAVER_MIN_REGION_SPECIFICITY=5

# ODsay API (대중교통)
ODSAY_API_KEY=
# ODsay 는 키 발급 시 등록한 서비스 URL 을 Referer 로 검증한다.
# 등록한 값과 정확히 같아야 하며, 없으면 ApiKeyAuthFailed 로 폴백된다.
ODSAY_SERVICE_URL=http://localhost:4000

# 기상청 단기예보
KMA_API_KEY=

# 한국관광공사
KTO_API_KEY=
# 적재 시 detailIntro2 로 영업시간을 조회한다 (장소당 API 호출 1건 추가). 일일 트래픽이 빠듯하면 false
KTO_FETCH_OPENING_HOURS=true
# detailIntro2 동시 조회 수 (1~16)
KTO_INTRO_CONCURRENCY=4
# 적재 1회 실행의 KTO 호출 예산 (일일 한도 API별 1000 보호). 소진 시 --append 로 이어받기
KTO_DAILY_CALL_BUDGET=900

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object Storage (MinIO 로컬 / Cloudflare R2 라이브)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tripick
# 상대경로 → web(Next) `/storage` 프록시 경유(웹뷰/브라우저 공통). 라이브(R2)는 실 도메인 절대 URL.
STORAGE_PUBLIC_URL=/storage

# Local LLM (OpenAI-compatible) — chat/planner 용
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=career-agent-planner
# 임베딩 전용 서버 (별도 포트). 미설정 시 LLM_BASE_URL 로 폴백
LLM_EMBEDDING_BASE_URL=http://localhost:8081/v1
# LLM_EMBEDDING_API_KEY=local   # 임베딩 서버 키가 다를 때만 설정 (미설정 시 LLM_API_KEY 폴백)
# 임베딩 모델명은 서빙 스택(TEI/Infinity/vLLM)에 등록된 이름과 일치해야 함
LLM_EMBEDDING_MODEL=dragonkue/BGE-m3-ko
# BGE-m3(-ko)=1024. init.sql 의 vector(N) 컬럼과 반드시 동일해야 함
LLM_EMBEDDING_DIMENSIONS=1024
LLM_PLANNER_ENABLED=true
LLM_PLANNER_TIMEOUT_MS=12000
LLM_PLANNER_TEMPERATURE=0.2
# 취향 사진 분석 (vision). mmproj 를 올린 LLM_BASE_URL 서버를 그대로 쓰므로 아래 두 줄은 보통 불필요
# LLM_VISION_BASE_URL=http://localhost:8082/v1
# LLM_VISION_MODEL=gemma-4-vision
# 이미지 프리필 때문에 텍스트 추론보다 느리다
LLM_VISION_TIMEOUT_MS=90000
LLM_VISION_TEMPERATURE=0.1

# RAG / CRAG retrieval
# true면 로컬 개발 DB가 비어 있을 때 seed 장소를 place_embeddings에 자동 주입한다.
PLACE_RETRIEVAL_AUTO_SEED=true
# 최종 후보 수(16)의 몇 배까지 pgvector 에서 뽑을지. 인지도·취향 재정렬이 손댈 수 있는 범위의
# 한계다 — 선발은 벡터 거리만 보므로 이 풀에 못 든 장소는 결과에 나올 길이 없다.
# ⚠️ 카탈로그 크기에 묶인 값이다. 10 은 카탈로그 10,333행 시절 무릎이었고 전국 적재(40,304행)
# 후에는 20 이 무릎이다(R@10 0.356→0.423, 응답 53→60ms). 적재를 크게 늘리면 다시 스윕할 것.
PLACE_CANDIDATE_POOL_MULTIPLIER=20
# 행정구역으로 안 잡히는 목적지('광안리'·'남이섬')를 카카오 로컬로 좌표 해석해 반경 검색을 쓴다.
# false 면 기존 지역 코드 검색만 쓴다(그 목적지는 후보 0건 → 카카오·시드 폴백).
DESTINATION_ANCHOR_ENABLED=true
# 앵커 반경 확장 단계(m, 쉼표). 앞 단계에서 후보가 얇으면 다음으로 넓히고, 마지막까지 부족하면
# 앵커가 알아낸 시도 전역을 덧댄다. 고정 반경은 안 된다 — 실측에서 광안리 2km 는 식당·카페가
# 2곳뿐이고, 에버랜드는 10km 로도 15건이라 어느 값으로도 양쪽을 못 맞춘다.
PLACE_ANCHOR_RADIUS_STEPS_M=2000,5000,10000
# 인지도 항을 켤 최소 언급 비율. 네이버 검색 description 이 120자 스니펫이라 코퍼스가 그 지역
# 장소를 담아내는 정도가 지역마다 1.3%(대구)~59.2%(속초)로 46배 벌어진다. 이만큼도 안 잡히면
# '언급 0' 은 마이너가 아니라 정보 없음이므로 항을 끄고 나머지 항에 맡긴다.
# ⚠️ 0 이나 1 로 두지 말 것 — 항상 끄면 골든셋 R|cat 이 0.631→0.364 로 무너진다.
CRAG_MIN_POPULARITY_COVERAGE=0.05
# 태그가 폴백(cultural·city)뿐인 후보의 취향 점수를 중립으로 둘지. 사전이 이름에서 아무것도
# 못 읽은 것을 "취향에 안 맞다"로 읽으면 사전의 빈틈이 그대로 감점이 된다 — 인지도 1.00 인
# 대표 명소(신흥사·영금정·오륙도)가 taste 0.54 로 17~19위까지 밀렸다.
# ⚠️ 커버리지가 얇을 때는 손해였다(74% 시절 개선 5/악화 5). 97% 에서 개선 3/악화 1.
CRAG_TASTE_FALLBACK_NEUTRAL=true
# 앵커 반경 경계의 locality 점수 = 거리 항의 세기. 0.95 면 사실상 끈 것(전 후보 동점).
# 앵커 목적지는 행정 경계가 아니라 그 지점 주변이 범위라, 지역 코드로는 반경 안이 전부 같은
# 시도여서 아무것도 못 가른다. 스윕 무릎이 0.7 이고 0.6 부터는 거리가 과해져 정답을 잃는다.
CRAG_ANCHOR_EDGE_SCORE=0.7
CRAG_MIN_CONFIDENCE=0.52
# 이 값을 밑돌면 카카오·시드 폴백을 부른다. 가중표(항 구성)에 묶인 절대 임계이므로 항을 더하거나
# 빼면 함께 재보정해야 한다 — dataQuality 항 제거로 confidence 레벨이 0.02 내려가 0.64→0.61.
CRAG_TARGET_CONFIDENCE=0.61
# CRAG 총점에서 pgvector 유사도 항의 가중치. 실측 코사인이 좁은 밴드(p5 0.433~p95 0.589)에만
# 몰려 이 항의 총점 스프레드가 0.019 라, 큰 가중은 일하는 항(popularity·taste)을 희석만 한다.
# 나머지 항은 남은 몫을 비례 배분해 합 1 을 지키므로(confidence 의 절대 의미 유지) 이 값만 스윕한다:
#   pnpm eval:retrieval -- --sweep=CRAG_RETRIEVAL_WEIGHT=0,0.03,0.06,0.10,0.24
CRAG_RETRIEVAL_WEIGHT=0.06

# Email (이메일 인증·비밀번호 재설정)
# EMAIL_TRANSPORT=console: 발송 안 하고 콘솔에 본문 출력 (가장 빠른 dev 동선)
# EMAIL_TRANSPORT=resend:  Resend HTTP API (RESEND_API_KEY 필요). 프로덕션 권장 —
#                          PaaS 가 아웃바운드 SMTP 포트를 막아도 443 만 쓰므로 영향 없다
# EMAIL_TRANSPORT=smtp:    SMTP_HOST/PORT 사용 (로컬 Mailpit)
# 프로덕션(NODE_ENV=production)에서 실제로 발송 가능한 설정이 아니면 **부팅이 거부된다** —
# console 폴백은 응답 200 · 메일 0통 · 에러 로그도 없는 조용한 사고라 부팅이 유일한 신호다.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=TriPick <noreply@tripick.place>
# 발송 한 건의 상한(ms). 발송이 가입·재설정 응답 경로에 동기로 물려 있어 상한이 필요하다.
EMAIL_SEND_TIMEOUT_MS=10000

# EMAIL_TRANSPORT=resend 일 때. EMAIL_FROM 의 도메인이 Resend 에서 인증돼 있어야 한다.
RESEND_API_KEY=

# EMAIL_TRANSPORT=smtp 일 때. 포트·secure 는 짝이 맞아야 한다 (465+true 또는 587+false).
# SMTP_SECURE 는 문자열 'true' 와 정확히 비교한다 — 'True'·'1' 은 false 로 읽힌다.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sentry (에러·트레이싱). 비워두면 SDK 가 no-op 이라 로컬은 꺼진 채 돈다.
SENTRY_DSN=
# 미지정 시 NODE_ENV 사용. 배포 환경 구분이 필요하면 production/staging 등으로 지정.
SENTRY_ENVIRONMENT=
