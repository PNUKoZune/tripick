# App
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://tripick:tripick@localhost:5432/tripick

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/api/v1/auth/kakao/callback
WEB_APP_URL=http://localhost:3000

# Kakao Local API (장소 검색)
KAKAO_LOCAL_API_KEY=
# 런타임 키워드 검색 반경(m). currentLocation 이 있을 때만 적용. 최대 20000
KAKAO_SEARCH_RADIUS_M=20000
# 적재 카테고리 검색 반경(m). 앵커 1곳이 커버하는 범위. 최대 20000
KAKAO_INGEST_RADIUS_M=10000
# 적재 시 시도별 카카오 앵커(관광공사 좌표 클러스터 중심) 최대 개수
KAKAO_INGEST_MAX_ANCHORS=8

# 자동차 경로·ETA: 카카오 모빌리티 길찾기 (KAKAO_REST_API_KEY 공용)

# ODsay API (대중교통)
ODSAY_API_KEY=
# ODsay 는 키 발급 시 등록한 서비스 URL 을 Referer 로 검증한다.
# 등록한 값과 정확히 같아야 하며, 없으면 ApiKeyAuthFailed 로 폴백된다.
ODSAY_SERVICE_URL=http://localhost:4000

# 기상청 단기예보
KMA_API_KEY=

# 한국관광공사
KTO_API_KEY=
# 적재 시 detailIntro2 로 영업시간을 조회한다 (장소당 API 호출 1건 추가). 일일 트래픽이 빠듯하면 false
KTO_FETCH_OPENING_HOURS=true
# detailIntro2 동시 조회 수 (1~16)
KTO_INTRO_CONCURRENCY=4

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object Storage (MinIO 로컬 / Cloudflare R2 라이브)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tripick
STORAGE_PUBLIC_URL=http://localhost:9000/tripick

# Local LLM (OpenAI-compatible) — chat/planner 용
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=career-agent-planner
# 임베딩 전용 서버 (별도 포트). 미설정 시 LLM_BASE_URL 로 폴백
LLM_EMBEDDING_BASE_URL=http://localhost:8081/v1
# LLM_EMBEDDING_API_KEY=local   # 임베딩 서버 키가 다를 때만 설정 (미설정 시 LLM_API_KEY 폴백)
# 임베딩 모델명은 서빙 스택(TEI/Infinity/vLLM)에 등록된 이름과 일치해야 함
LLM_EMBEDDING_MODEL=dragonkue/BGE-m3-ko
# BGE-m3(-ko)=1024. init.sql 의 vector(N) 컬럼과 반드시 동일해야 함
LLM_EMBEDDING_DIMENSIONS=1024
LLM_PLANNER_ENABLED=true
LLM_PLANNER_TIMEOUT_MS=12000
LLM_PLANNER_TEMPERATURE=0.2

# RAG / CRAG retrieval
# true면 로컬 개발 DB가 비어 있을 때 seed 장소를 place_embeddings에 자동 주입한다.
PLACE_RETRIEVAL_AUTO_SEED=true
CRAG_MIN_CONFIDENCE=0.52
CRAG_TARGET_CONFIDENCE=0.64

# Email (SMTP / 이메일 인증·비밀번호 재설정)
# EMAIL_TRANSPORT=console: 발송 안 하고 콘솔에 본문 출력 (가장 빠른 dev 동선)
# EMAIL_TRANSPORT=smtp:    SMTP_HOST/PORT 사용 (로컬 Mailpit 또는 Resend/SendGrid SMTP)
EMAIL_TRANSPORT=smtp
EMAIL_FROM=TriPick <noreply@tripick.place>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sentry
SENTRY_DSN=
