# App
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://tripick:tripick@localhost:5432/tripick

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/api/v1/auth/kakao/callback

# Kakao Local API (장소 검색)
KAKAO_LOCAL_API_KEY=

# TMAP API (경로·ETA)
TMAP_API_KEY=

# ODsay API (대중교통)
ODSAY_API_KEY=

# 기상청 단기예보
KMA_API_KEY=

# 한국관광공사
KTO_API_KEY=

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object Storage (MinIO 로컬 / Cloudflare R2 라이브)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tripick
STORAGE_PUBLIC_URL=http://localhost:9000/tripick

# Local LLM (OpenAI-compatible)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=gemma-4

# Sentry
SENTRY_DSN=
