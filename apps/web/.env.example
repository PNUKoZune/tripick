# 상대 경로 → next.config rewrite 가 백엔드로 프록시(브라우저·RN 에뮬레이터 공통).
NEXT_PUBLIC_API_URL=/api/v1
# 비워두면 socket.ts 가 현재 호스트:4000 으로 자동 해석(dev). prod 는 실 WS 도메인 지정.
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Web Push (브라우저 단독 사용자 FCM 수신) — Firebase 콘솔 > 프로젝트 설정 > 웹 앱
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 클라우드 메시징 > 웹 푸시 인증서(키 쌍)의 공개 키
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Sentry (에러·트레이싱). 비워두면 SDK 가 no-op 이라 로컬은 그냥 꺼진 채 돈다.
NEXT_PUBLIC_SENTRY_DSN=
# 미지정 시 NODE_ENV 사용. 배포 환경 구분이 필요하면 production/preview 등으로 지정.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# 아래 3개는 빌드 시 소스맵 업로드용. 셋 다 있어야 업로드가 켜진다(CI·Vercel 에만 주입).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
