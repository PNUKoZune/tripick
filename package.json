{
  "name": "tripick",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "pnpm db:up && turbo run dev",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @tripick/mobile start",
    "dev:android": "pnpm --filter @tripick/mobile android",
    "dev:ios": "pnpm --filter @tripick/mobile ios",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:up": "docker compose up -d --wait postgres redis minio",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@turbo/gen": "^2.9.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.9",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.2.0": "^2.2.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "socket.io-parser@>=4.0.0 <4.2.7": "^4.2.7",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "qs@>=6.11.1 <6.15.2": "^6.15.2",
      "websocket-driver@<0.7.5": "^0.7.5",
      "protobufjs@<7.6.5": "^7.6.5",
      "@grpc/grpc-js@<1.9.16": "^1.9.16",
      "uuid@<11.1.1": "^11.1.1",
      "joi@<17.13.4": "^17.13.4",
      "dompurify@<=3.4.12": "^3.4.13",
      "fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
      "shell-quote@<=1.8.4": "^1.9.0",
      "fast-xml-parser@<5.7.0": "^5.7.0",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=6.0.0 <6.2.4": "^6.2.4",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "^5.0.9",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "@babel/core@<7.29.6": "^7.29.6"
    }
  }
}
